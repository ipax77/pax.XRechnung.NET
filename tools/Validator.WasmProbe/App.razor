@using Microsoft.AspNetCore.Components.Web
@using System.Diagnostics
@using System.Reflection
@using System.Xml.Linq
@using System.Text.Json
@using pax.XRechnung.NET

<h1>XRechnung and ZUGFeRD WASM validation</h1>
<p>Runs embedded fixtures through the library's public API. Disconnect networking after loading to check offline validation.</p>
<button @onclick="Run">Run validation</button>
<pre id="result">@result</pre>

@code {
    private string result = "Ready";

    private async Task Run()
    {
        result = "Running";
        await Task.Yield();
        var cbc = XNamespace.Get(XmlInvoiceWriter.CommonBasicComponents);
        var cac = XNamespace.Get(XmlInvoiceWriter.CommonAggregateComponents);
        using var stream = Assembly.GetExecutingAssembly().GetManifestResourceStream("invoice.xml")!;
        var xml = XDocument.Load(stream);
        var valid = xml.ToString();
        var totals = new XDocument(xml);
        totals.Descendants(cac + "TaxTotal").First().Element(cbc + "TaxAmount")!.Value = "18.00";
        var reference = new XDocument(xml);
        reference.Descendants(cbc + "BuyerReference").Remove();
        var code = new XDocument(xml);
        code.Descendants(cbc + "DocumentCurrencyCode").Single().Value = "ZZZ";
        var warning = new XDocument(xml);
        warning.Descendants(cbc + "InvoicedQuantity").First().SetAttributeValue("unitCode", "ZZZ");
        var schema = new XDocument(xml);
        schema.Descendants(cbc + "IssueDate").Single().Value = "invalid";
        var inputs = new[] {
            ("valid", valid, true, (string?)null),
            ("repeat", valid, true, (string?)null),
            ("badTotals", totals.ToString(), false, "BR-CO-15"),
            ("missingReference", reference.ToString(), false, "BR-DE-15"),
            ("badCode", code.ToString(), false, "BR-CL-04"),
            ("warning", warning.ToString(), true, "BR-CL-23"),
            ("schemaError", schema.ToString(), false, (string?)null),
            ("malformed", "<Invoice>", false, (string?)null),
            ("unsupported", "<CreditNote/>", false, (string?)null),
            ("dtd", "<!DOCTYPE Invoice [<!ENTITY test 'test'>]><Invoice>&test;</Invoice>", false, (string?)null)
        };
        var outputs = new List<object>();
        var passed = true;
        foreach (var (name, input, expectedValid, expectedCode) in inputs)
        {
            var timer = Stopwatch.StartNew();
            var validation = await XmlInvoiceValidator.ValidateSchematron(input);
            var ok = validation.IsValid == expectedValid && (expectedCode is null || validation.Validations.Any(m => m.Code == expectedCode));
            passed &= ok;
            outputs.Add(new {
                name, passed = ok, ms = timer.ElapsedMilliseconds,
                validation.IsValid, validation.Error, validation.HttpStatusCode,
                findings = validation.Validations.Select(m => new { m.Code, m.RuleSeverity, m.Path, m.Message }).ToArray()
            });
        }
        using var ciiStream = Assembly.GetExecutingAssembly().GetManifestResourceStream("zugferd-invoice.xml")!;
        var cii = XDocument.Load(ciiStream);
        XNamespace ram = "urn:un:unece:uncefact:data:standard:ReusableAggregateBusinessInformationEntity:100";
        var badCiiTotal = new XDocument(cii);
        badCiiTotal.Descendants(ram + "DuePayableAmount").Single().Value = "1.00";
        var badCiiCode = new XDocument(cii);
        badCiiCode.Descendants(ram + "InvoiceCurrencyCode").Single().Value = "ZZZ";
        var missingCiiName = new XDocument(cii);
        missingCiiName.Descendants(ram + "SellerTradeParty").Single().Element(ram + "Name")!.Remove();
        var badCiiSchema = new XDocument(cii);
        badCiiSchema.Descendants(ram + "InvoiceCurrencyCode").Single().AddBeforeSelf(new XElement(ram + "Unexpected"));
        var ciiWarning = new XDocument(cii);
        ciiWarning.Root!.Elements().Single(e => e.Name.LocalName == "ExchangedDocument").Element(ram + "ID")!.SetAttributeValue("schemeID", "unused");
        var ciiProfile = new XDocument(cii);
        ciiProfile.Descendants(ram + "GuidelineSpecifiedDocumentContextParameter").Single().Element(ram + "ID")!.Value = "urn:factur-x.eu:1p0:basic";
        var ciiInputs = new[] {
            ("ciiValid", cii.ToString(), true),
            ("ciiRepeat", cii.ToString(), true),
            ("ciiBadTotals", badCiiTotal.ToString(), false),
            ("ciiBadCode", badCiiCode.ToString(), false),
            ("ciiMissingName", missingCiiName.ToString(), false),
            ("ciiSchemaError", badCiiSchema.ToString(), false),
            ("ciiWarning", ciiWarning.ToString(), true),
            ("ciiUnsupportedProfile", ciiProfile.ToString(), false),
            ("ciiMalformed", "<CrossIndustryInvoice>", false),
            ("ciiDtd", "<!DOCTYPE CrossIndustryInvoice [<!ENTITY test 'test'>]><CrossIndustryInvoice>&test;</CrossIndustryInvoice>", false)
        };
        foreach (var (name, input, expectedValid) in ciiInputs)
        {
            var timer = Stopwatch.StartNew();
            var validation = ZugferdXmlValidator.Validate(input);
            var ok = validation.IsValid == expectedValid;
            if (name == "ciiBadTotals") ok &= validation.Validations.Any(m => m.Message.Contains("BR-CO-16"));
            if (name == "ciiBadCode") ok &= validation.Error is null && validation.Validations.Any(m => m.Message.Contains("not allowed"));
            if (name == "ciiMissingName") ok &= validation.Validations.Any(m => m.Message.Contains("BR-06"));
            if (name == "ciiWarning") ok &= validation.Validations.Any(m => m.RuleSeverity == "warning");
            passed &= ok;
            outputs.Add(new {
                name, passed = ok, ms = timer.ElapsedMilliseconds,
                validation.IsValid, validation.Error, validation.HttpStatusCode,
                findings = validation.Validations.Select(m => new { m.Code, m.RuleSeverity, m.Path, m.Message }).ToArray()
            });
        }
        result = JsonSerializer.Serialize(new { passed, outputs }, new JsonSerializerOptions { WriteIndented = true });
    }
}
